generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id          String     @id @default(cuid())
  userId      String?
  userEmail   String?
  patientName String     @default("Self")
  reportType  String
  labName     String?
  reportDate  DateTime?
  rawText     String?
  createdAt   DateTime   @default(now())
  tests       Test[]

  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
}

model FamilyMember {
  id         String    @id @default(cuid())
  userId     String?
  name       String
  relation   String    @default("Self") // Self, Father, Mother, Spouse, Child, Other
  gender     String?   // Male, Female, Other
  birthDate  DateTime?
  bloodGroup String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Test {
  id        String  @id @default(cuid())
  reportId  String
  name      String
  category  String  @default("Other")
  value     Float
  unit      String?
  refLow    Float?
  refHigh   Float?
  flag      String  @default("NORMAL") // NORMAL | HIGH | LOW
  verified  Boolean @default(false)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([name])
}
